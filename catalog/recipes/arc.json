{
  "recipe_id": "arc",
  "category": "browser",
  "orders": {
    "native": {
      "macos": {
        "manager": "brew-cask",
        "steps": [
          "brew install --cask arc"
        ],
        "verify": "ls /applications/arc.app"
      },
      "windows": {
        "manager": "winget",
        "steps": [
          "winget install -e --id TheBrowserCompany.Arc"
        ],
        "verify": "test -d \"$env:LOCALAPPDATA\\Packages\\TheBrowserCompany.Arc*\" -or (test -d \"$env:LOCALAPPDATA\\arc\")"
      }
    }
  },
  "availability": {
    "windows": [
      "native"
    ],
    "macos": [
      "native"
    ]
  },
  "notes": "winding down (browser company moved on to dia); kept for existing users on both platforms",
  "disk_mb_est": 500
}
