{
  "recipe_id": "kicad",
  "category": "engineering",
  "orders": {
    "native": {
      "debian": {
        "manager": "apt",
        "steps": [
          "apt install -y kicad"
        ],
        "verify": "kicad-cli version"
      },
      "fedora": {
        "manager": "dnf",
        "steps": [
          "dnf install -y kicad"
        ],
        "verify": "kicad-cli version"
      },
      "arch": {
        "manager": "pacman",
        "steps": [
          "pacman -S --noconfirm kicad"
        ],
        "verify": "kicad-cli version"
      },
      "windows": {
        "manager": "winget",
        "steps": [
          "winget install -e --id KiCad.KiCad"
        ],
        "verify": "kicad-cli version"
      },
      "macos": {
        "manager": "brew-cask",
        "steps": [
          "brew install --cask kicad"
        ],
        "verify": "ls /applications/kicad.app"
      }
    }
  },
  "availability": {
    "linux": [
      "native"
    ],
    "windows": [
      "native"
    ],
    "macos": [
      "native"
    ]
  },
  "pin": {
    "cinnamon": "menu",
    "gnome": "dash",
    "windows": "startmenu",
    "macos": "dock"
  },
  "egress_required": true,
  "disk_mb_est": 1400,
  "license": "foss"
}
