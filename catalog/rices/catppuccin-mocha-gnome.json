{
  "rice_id": "catppuccin-mocha-gnome",
  "version": "1.0.0",
  "compatible_desktops": [
    "gnome"
  ],
  "theme_engine": "gtk",
  "assets": {
    "gtk_theme": "assets/catppuccin-mocha.zip"
  },
  "apply": {
    "steps": [
      "unzip -o assets/catppuccin-mocha.zip -d ~/.themes",
      "gsettings set org.gnome.desktop.interface gtk-theme 'catppuccin-mocha-standard'"
    ]
  },
  "source": "github:catppuccin/catppuccin"
}
